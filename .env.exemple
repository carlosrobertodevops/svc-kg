# =============================================================================
# Arquivo: .env.exemple
# Versão: v1.8.0
# Objetivo: Variáveis de ambiente do micro-serviço (produção/local).
#           MIGRADO: agora consome Postgres + Redis do stack mondaha
#           diretamente (DATABASE_URL). Supabase deprecado.
# Funções/métodos:
# - Define CORS, Postgres (pool + auto-migrate), Redis e cache da API
# =============================================================================

# App
APP_ENV=production
APP_HOST=svc-kg.mondaha.com
PORT=8080
LOG_LEVEL=info

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=false

# Cache
ENABLE_REDIS_CACHE=true
REDIS_URL=redis://redis:6379/0
CACHE_API_TTL=60

# Postgres (stack mondaha)
# in-network (containers na mesma rede): host = nome do serviço "postgres"
DATABASE_URL=postgresql://mondaha:mondaha@postgres:5432/mondaha
# via host (rodando svc-kg fora do docker): use localhost
# DATABASE_URL=postgresql://mondaha:mondaha@localhost:5432/mondaha
PG_POOL_MAX=10
PG_POOL_TIMEOUT=10
KG_AUTO_MIGRATE=true

# DEPRECATED: migrado para Postgres direto (DATABASE_URL). Supabase não é mais usado.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_RPC_FN=get_graph_membros
# SUPABASE_TIMEOUT=15

# Tabela de fotos
MEMBERS_TABLE=membros
MEMBERS_ID_COL=id
MEMBERS_PHOTO_COL=photo_url

CACHE_STATIC_MAX_AGE=86400

# <<< Somente se usar docker-compose.coolify-proxy.yml >>>
COOLIFY_PROXY_NETWORK=coolify-proxy

# opcional: para teste
SERVER_CMD=gunicorn
